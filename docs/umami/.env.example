# 复制为同目录下的 .env 后修改（.env 已被仓库 gitignore 规则覆盖，不会提交）。
# 生成强随机值：openssl rand -hex 32

# [必填] PostgreSQL 密码（容器内部使用，不要复用其它服务的密码）
POSTGRES_PASSWORD=change-me-strong-db-password

# [必填] Umami 应用密钥（会话/加密用，至少 32 位随机串）
APP_SECRET=change-me-random-app-secret-at-least-32-chars

# [可选] 容器绑定的本机回环端口，默认 3000；被占用时改成 3001 等
UMAMI_PORT=3000

# [可选] 容器时区
TZ=Asia/Shanghai
