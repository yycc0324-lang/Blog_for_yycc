---
interface Props {
	/** 站点 IANA 时区（如 Asia/Shanghai），用于计算「今日」的自然日起点 */
	timezone?: string;
}

const { timezone = "" } = Astro.props;
// Optional Umami assets are mounted once in the persistent layout shell.
---

<style is:inline data-shirone-umami-runtime>
	.shirone-umami-stats {
		color: var(--on-surface-variant);
	}

	.shirone-umami-stats--meta {
		display: inline-flex;
		align-items: center;
		gap: var(--m3e-space-2);
		min-height: 2rem;
	}

	.shirone-umami-stats--badge {
		display: none;
		align-items: center;
		gap: var(--m3e-space-1);
		min-height: 2rem;
		padding-inline: var(--m3e-space-2);
		border-radius: var(--shape-corner-full);
		background: var(--surface-container-high);
		color: var(--on-surface-variant);
		white-space: nowrap;
	}

	@media (min-width: 480px) {
		.shirone-umami-stats--badge {
			display: inline-flex;
		}
	}

	.shirone-umami-stats--badge > svg {
		display: block;
		inline-size: 1rem;
		block-size: 1rem;
		flex: 0 0 auto;
	}

	.shirone-umami-stats[data-shirone-umami-badge] [data-shirone-umami-display] {
		display: inline-flex;
		flex-wrap: nowrap;
		align-items: baseline;
		gap: 0;
		font: var(--m3e-type-body-small);
		font-weight: 500;
		white-space: nowrap;
	}

	.shirone-umami-stats [data-shirone-umami-display] {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--m3e-space-1) var(--m3e-space-3);
		min-inline-size: 0;
	}

	.shirone-umami-stats [data-shirone-umami-metric] {
		display: inline-flex;
		align-items: baseline;
		gap: var(--m3e-space-1);
		white-space: nowrap;
	}

	.shirone-umami-stats--meta [data-shirone-umami-display] {
		font: var(--m3e-type-body-medium);
		font-weight: 500;
	}

	.shirone-umami-stats [data-shirone-umami-value] {
		display: inline-block;
		inline-size: 7ch;
		flex: 0 0 7ch;
		font-variant-numeric: tabular-nums;
		text-align: end;
	}

	.shirone-umami-stats--profile {
		margin-top: var(--m3e-space-3);
	}

	.shirone-umami-stats--profile hr {
		margin: var(--m3e-space-2) 0;
		border: 0;
		border-top: 1px dashed var(--outline-variant);
	}

	.shirone-umami-stats--profile > div {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--m3e-space-2);
		font: var(--m3e-type-body-small);
		font-weight: 500;
		text-align: center;
	}

	.shirone-umami-stats--profile [data-shirone-umami-display] {
		display: grid;
		grid-template-columns: auto auto auto;
		column-gap: var(--m3e-space-2);
		width: auto;
		justify-content: center;
		flex-wrap: nowrap;
		white-space: nowrap;
	}

	.shirone-umami-stats--profile [data-shirone-umami-metric]:first-child {
		justify-content: flex-end;
	}

	.shirone-umami-stats--profile [data-shirone-umami-metric]:last-child {
		justify-content: flex-start;
	}

	.shirone-umami-stats__separator {
		color: var(--outline);
	}

	.shirone-umami-stats--profile [data-shirone-umami-value] {
		inline-size: auto;
		flex: 0 0 auto;
	}

	.shirone-umami-stats--profile svg {
		width: 1rem;
		height: 1rem;
	}
</style>

<script is:inline define:vars={{ timezone }}>
	(() => {
		const rootSelector = "[data-shirone-umami]";
		let scheduled = false;

		function formatCount(value) {
			try {
				return new Intl.NumberFormat(document.documentElement.lang || undefined, {
					notation: "compact",
					compactDisplay: "short",
					maximumFractionDigits: 1,
				}).format(value);
			} catch {
				return String(value);
			}
		}

		function schedule() {
			if (scheduled) return;
			scheduled = true;
			const run = () => {
				scheduled = false;
				// 内联脚本在 <body> 顶部执行时页脚还没解析出来，所以绑定放在首次调度里。
				bindRangeRefresh();
				void loadStats();
			};
			if (typeof window.requestAnimationFrame === "function") {
				window.requestAnimationFrame(run);
			} else {
				window.setTimeout(run, 0);
			}
		}

		/**
		 * 计算指定 IANA 时区下「今天 00:00」的绝对时间戳（毫秒）。
		 * 传空字符串时退回浏览器本地时区。用一遍「猜偏移 → 修正」即可覆盖夏令时。
		 */
		function startOfDayInTimeZone(zone, now) {
			if (!zone) {
				const local = new Date(now);
				local.setHours(0, 0, 0, 0);
				return local.getTime();
			}
			const offsetAt = (timestamp) => {
				try {
					const parts = new Intl.DateTimeFormat("en-US", {
						timeZone: zone,
						hourCycle: "h23",
						year: "numeric",
						month: "2-digit",
						day: "2-digit",
						hour: "2-digit",
						minute: "2-digit",
						second: "2-digit",
					}).formatToParts(new Date(timestamp));
					const map = {};
					for (const part of parts) map[part.type] = part.value;
					return (
						Date.UTC(
							Number(map.year),
							Number(map.month) - 1,
							Number(map.day),
							Number(map.hour),
							Number(map.minute),
							Number(map.second),
						) - timestamp
					);
				} catch {
					return null;
				}
			};
			const initialOffset = offsetAt(now);
			if (initialOffset === null) return startOfDayInTimeZone("", now);
			const wallClock = new Date(now + initialOffset);
			wallClock.setUTCHours(0, 0, 0, 0);
			const candidateOffset = offsetAt(wallClock.getTime() - initialOffset);
			return wallClock.getTime() - (candidateOffset ?? initialOffset);
		}

		/**
		 * 把 data-shirone-umami-range 翻译成 oddmisc 查询参数。
		 * today：站点时区当天 00:00 起；total：全部时间（startAt: 0）。
		 * 不传 endAt，交给 oddmisc 使用「5 分钟对齐的当前时间」，这样同一个
		 * 5 分钟窗口内能命中它自带的缓存，同时保证数据足够新鲜。
		 */
		function rangeOptions(range) {
			if (range === "today") {
				return { startAt: startOfDayInTimeZone(timezone, Date.now()) };
			}
			if (range === "total") return { startAt: 0 };
			return undefined;
		}

		function requestStats(client, path, options) {
			return path
				? client.getPageStats(path, options)
				: client.getSiteStats(options);
		}

		// ── 区间统计刷新（今日访客 / 累计访问）────────────────────────────
		// 首次读取往往早于「本次访问」被 Umami 聚合完成，所以 10 秒后补一次；
		// 标签页重新可见时也刷新一次，但用最小间隔限流，避免反复切页刷爆接口。
		const RANGE_ROOT_SELECTOR = "[data-shirone-umami-range]";
		const RANGE_REFRESH_MIN_INTERVAL = 60_000;
		let lastRangeRefreshAt = 0;

		function hasRangeRoots() {
			return document.querySelector(RANGE_ROOT_SELECTOR) !== null;
		}

		function refreshRangeStats(force) {
			if (!hasRangeRoots() || !window.oddmisc) return;
			const now = Date.now();
			if (!force && now - lastRangeRefreshAt < RANGE_REFRESH_MIN_INTERVAL) {
				return;
			}
			lastRangeRefreshAt = now;
			const promises = window.__shironeUmamiStatsPromises;
			document.querySelectorAll(RANGE_ROOT_SELECTOR).forEach((root) => {
				delete root.dataset.umamiLoaded;
				// 关键：内存里还留着上一轮已完成的 Promise，不清掉就会直接复用旧结果、不发请求。
				if (promises) {
					const path = root.dataset.umamiPath;
					const range = root.dataset.shironeUmamiRange;
					const key = `${path ? `page:${path}` : "site"}${range ? `:${range}` : ""}`;
					delete promises[key];
				}
			});
			schedule();
		}

		let rangeRefreshBound = false;
		function bindRangeRefresh() {
			if (rangeRefreshBound || !hasRangeRoots()) return;
			rangeRefreshBound = true;
			// 本次访问发生在本页加载之后，稍等聚合完成再补一次，让「自己刚访问」也能看到。
			window.setTimeout(() => refreshRangeStats(true), 10_000);
			// 标签页重新可见时刷新（有最小间隔限流）。
			document.addEventListener("visibilitychange", () => {
				if (!document.hidden) refreshRangeStats(false);
			});
		}

		async function loadStats() {
			const roots = Array.from(document.querySelectorAll(rootSelector)).filter(
				(root) => !root.dataset.umamiLoaded,
			);
			const client = window.oddmisc;
			if (roots.length === 0 || !client) return;

			// 「今日访客 / 累计访问」必须实时：oddmisc 默认把结果缓存 1 小时
			// （localStorage + 内存），这里在读取区间统计前先清一次，强制走网络。
			if (roots.some((root) => root.dataset.shironeUmamiRange)) {
				client.clearCache();
			}

			const promises = (window.__shironeUmamiStatsPromises ??= {});
			await Promise.all(
				roots.map(async (root) => {
					root.dataset.umamiLoaded = "loading";
					const path = root.dataset.umamiPath;
					const range = root.dataset.shironeUmamiRange;
					const options = rangeOptions(range);
					const key = `${path ? `page:${path}` : "site"}${range ? `:${range}` : ""}`;
					const request = (promises[key] ??= requestStats(
						client,
						path,
						options,
					));

					try {
						let stats = await request;
						if (
							(stats.pageviews || 0) === 0 &&
							(stats.visits || 0) === 0 &&
							stats._fromCache
						) {
							client.clearCache();
							const refreshed = requestStats(client, path, options);
							promises[key] = refreshed;
							stats = await refreshed;
						}
						if (!root.isConnected) return;

						const pageViews = Number.isFinite(stats.pageviews)
							? stats.pageviews
							: 0;
						const visits = Number.isFinite(stats.visits) ? stats.visits : 0;
						const visitors = Number.isFinite(stats.visitors)
							? stats.visitors
							: 0;
						const pageViewsDisplay = root.querySelector(
							"[data-shirone-umami-pageviews]",
						);
						const visitsDisplay = root.querySelector(
							"[data-shirone-umami-visits]",
						);
						const visitorsDisplay = root.querySelector(
							"[data-shirone-umami-visitors]",
						);
						const display = root.querySelector(
							"[data-shirone-umami-display]",
						);
						if (
							!display ||
							(!pageViewsDisplay && !visitsDisplay && !visitorsDisplay)
						) {
							return;
						}

						if (pageViewsDisplay) {
							pageViewsDisplay.textContent = formatCount(pageViews);
							pageViewsDisplay.setAttribute("title", String(pageViews));
						}
						if (visitsDisplay) {
							visitsDisplay.textContent = formatCount(visits);
							visitsDisplay.setAttribute("title", String(visits));
						}
						if (visitorsDisplay) {
							visitorsDisplay.textContent = formatCount(visitors);
							visitorsDisplay.setAttribute("title", String(visitors));
						}
						display.setAttribute("aria-busy", "false");
						root.dataset.umamiLoaded = "true";
					} catch {
						delete promises[key];
						if (!root.isConnected) return;
						root
							.querySelector("[data-shirone-umami-display]")
							?.setAttribute("aria-busy", "false");
						root.dataset.umamiLoaded = "true";
					}
				}),
			);
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", schedule, { once: true });
		} else {
			schedule();
		}
		window.addEventListener("oddmisc-ready", schedule);
		document.addEventListener("swup:content:replace", schedule);
		document.addEventListener("swup:page:view", schedule);
	})();
</script>
