---
import { Icon } from "astro-icon/components";
import { announcementConfig } from "@/config/announcementConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import WidgetLayout from "./WidgetLayout.astro";

const config = announcementConfig;

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
const contentText = config.content || config.text || "";
const link = config.link;
const hasLink = link && link.enable !== false && link.text && link.url;
const isExternal =
	hasLink &&
	(link.external === true ||
		(/^https?:\/\//i.test(link.url) && link.external !== false));
const closeDuration = Number(config.closeDuration ?? 86400);

/**
 * 公告「指纹」：内容 / 标题 / 链接 / 关闭周期 任意一项变化，指纹就会变，
 * 旧的「已关闭」记录随即失效 —— 公告会重新展示给访客。
 */
function hashAnnouncement(input: string): string {
	let h1 = 0xdeadbeef;
	let h2 = 0x41c6ce57;
	for (let i = 0; i < input.length; i++) {
		const ch = input.charCodeAt(i);
		h1 = Math.imul(h1 ^ ch, 2654435761);
		h2 = Math.imul(h2 ^ ch, 1597334677);
	}
	h1 =
		Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^
		Math.imul(h2 ^ (h2 >>> 13), 3266489909);
	h2 =
		Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^
		Math.imul(h1 ^ (h1 >>> 13), 3266489909);
	return `${(h1 >>> 0).toString(16).padStart(8, "0")}${(h2 >>> 0)
		.toString(16)
		.padStart(8, "0")}`;
}

const announcementHash = hashAnnouncement(
	JSON.stringify({
		content: contentText,
		title: config.title ?? "",
		closable: config.closable ?? false,
		closeDuration,
		link: hasLink
			? { text: link.text, url: link.url, external: isExternal }
			: null,
	}),
);
---

<!-- 组件显示由 sidebarConfig 统一控制，有内容时渲染 -->
{contentText && (
	<WidgetLayout
		name={config.title || i18n(I18nKey.announcement)}
		id="announcement"
		class={className}
		style={style}
	>
		<div
			class="announcement-wrapper flex flex-col"
			data-close-duration={String(closeDuration)}
			data-announcement-hash={announcementHash}
		>
			<!-- 公告栏内容 -->
			<div class="announcement-content">
				{contentText}
			</div>

			<!-- 可选链接和关闭按钮 -->
			{(hasLink || config.closable) && (
				<div class="announcement-actions">
					<div>
						{hasLink && (
							<a
								href={link.url}
								target={isExternal ? "_blank" : "_self"}
								rel={isExternal ? "noopener noreferrer" : undefined}
								class="announcement-btn m3-state-layer"
							>
								<span>{link.text}</span>
								{isExternal && (
									<Icon
										name="material-symbols:arrow-outward-rounded"
										class="announcement-btn__icon"
									/>
								)}
							</a>
						)}
					</div>

					{config.closable && (
						<button
							type="button"
							class="announcement-close-btn m3-state-layer"
							onclick="closeAnnouncement()"
							aria-label={i18n(I18nKey.announcementClose)}
							title={i18n(I18nKey.announcementClose)}
						>
							<Icon name="material-symbols:close-rounded" class="announcement-close-btn__icon" />
						</button>
					)}
				</div>
			)}
		</div>
	</WidgetLayout>
)}

<style lang="stylus">
.announcement-content
	font: var(--m3e-type-body-medium)
	color: var(--on-surface-variant)
	line-height: 1.6
	margin-bottom: var(--m3e-space-3)
	word-break: break-word
	white-space: pre-line

.announcement-actions
	display: flex
	align-items: center
	justify-content: space-between
	gap: var(--m3e-space-3)

.announcement-btn
	display: inline-flex
	align-items: center
	gap: var(--m3e-space-1)
	height: 2rem
	padding: 0 var(--m3e-space-3)
	border-radius: var(--shape-corner-m)
	background: var(--secondary-container)
	color: var(--on-secondary-container)
	font: var(--m3e-type-label-medium)
	font-weight: 500
	text-decoration: none
	--m3e-state-color: var(--on-secondary-container)
	transition: background-color var(--m3e-duration-short) var(--m3e-easing-standard)

	&__icon
		width: 1rem
		height: 1rem
		opacity: 0.8

.announcement-close-btn
	display: flex
	align-items: center
	justify-content: center
	width: 2rem
	height: 2rem
	border-radius: var(--shape-corner-full)
	background: var(--btn-regular-bg)
	color: var(--on-surface-variant)
	cursor: pointer
	border: none
	--m3e-state-color: var(--error)
	transition:
		color var(--m3e-duration-short) var(--m3e-easing-standard),
		background-color var(--m3e-duration-short) var(--m3e-easing-standard)

	&:hover
		color: var(--error)
		background: var(--error-container)

	&__icon
		width: 1.125rem
		height: 1.125rem
</style>

<script>
	const STORAGE_KEY_CLOSED = "announcementClosed";
	const STORAGE_KEY_TIME = "announcementClosedTime";

	type Keys = { closed: string; time: string };

	/** 当前公告的内容指纹（由服务端渲染时写进 data 属性） */
	function getCurrentHash(): string {
		const wrapper = document.querySelector<HTMLElement>(".announcement-wrapper");
		return wrapper?.getAttribute("data-announcement-hash") ?? "";
	}

	function keysForHash(hash: string): Keys {
		const suffix = hash ? `:${hash}` : "";
		return {
			closed: `${STORAGE_KEY_CLOSED}${suffix}`,
			time: `${STORAGE_KEY_TIME}${suffix}`,
		};
	}

	/** 把旧版（无指纹）的关闭状态迁移到当前指纹下，避免升级后公告又突然冒出来 */
	function migrateLegacyKeys(keys: Keys): void {
		const legacyClosed = localStorage.getItem(STORAGE_KEY_CLOSED);
		if (legacyClosed === "true" && localStorage.getItem(keys.closed) === null) {
			localStorage.setItem(keys.closed, "true");
			const legacyTime = localStorage.getItem(STORAGE_KEY_TIME);
			localStorage.setItem(keys.time, legacyTime ?? Date.now().toString());
		}
	}

	/** 清掉过期 key（旧版无指纹的 + 其它内容指纹的），避免 localStorage 越积越多 */
	function cleanupStaleKeys(keys: Keys): void {
		for (let i = localStorage.length - 1; i >= 0; i--) {
			const key = localStorage.key(i);
			if (!key) continue;
			if (key === STORAGE_KEY_CLOSED || key === STORAGE_KEY_TIME) {
				localStorage.removeItem(key);
				continue;
			}
			const isAnnouncementKey =
				key.startsWith(`${STORAGE_KEY_CLOSED}:`) ||
				key.startsWith(`${STORAGE_KEY_TIME}:`);
			if (isAnnouncementKey && key !== keys.closed && key !== keys.time) {
				localStorage.removeItem(key);
			}
		}
	}

	function isAnnouncementExpired(keys: Keys, durationSeconds: number): boolean {
		if (Number.isNaN(durationSeconds) || durationSeconds <= 0) {
			return false; // 0 或非法值 = 永久关闭
		}
		const closedTime = localStorage.getItem(keys.time);
		if (!closedTime) {
			return true;
		}
		const elapsedSeconds = (Date.now() - Number(closedTime)) / 1000;
		return elapsedSeconds > durationSeconds;
	}

	function targetWidgets(): HTMLElement[] {
		return Array.from(
			document.querySelectorAll<HTMLElement>('widget-layout[data-id="announcement"]'),
		);
	}

	function setVisible(visible: boolean): void {
		targetWidgets().forEach((widget) => {
			const container = widget.closest<HTMLElement>(".sidebar-widget") || widget;
			container.style.display = visible ? "" : "none";
			widget.style.display = "";
		});
	}

	function closeAnnouncement(): void {
		if (targetWidgets().length === 0) return;
		const keys = keysForHash(getCurrentHash());
		localStorage.setItem(keys.closed, "true");
		localStorage.setItem(keys.time, Date.now().toString());
		setVisible(false);
	}

	function checkAnnouncementClosed(): void {
		if (targetWidgets().length === 0) return;

		const wrapper = document.querySelector<HTMLElement>(".announcement-wrapper");
		const durationAttr = wrapper?.getAttribute("data-close-duration");
		const durationSeconds = durationAttr ? Number.parseFloat(durationAttr) : 86400;

		const keys = keysForHash(getCurrentHash());
		migrateLegacyKeys(keys);
		cleanupStaleKeys(keys);

		if (localStorage.getItem(keys.closed) !== "true") {
			setVisible(true);
			return;
		}

		if (isAnnouncementExpired(keys, durationSeconds)) {
			localStorage.removeItem(keys.closed);
			localStorage.removeItem(keys.time);
			setVisible(true);
		} else {
			setVisible(false);
		}
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", checkAnnouncementClosed);
	} else {
		checkAnnouncementClosed();
	}

	document.addEventListener("swup:content:replace", checkAnnouncementClosed);

	const globalObj = window as unknown as {
		closeAnnouncement: () => void;
		checkAnnouncementClosed: () => void;
	};
	globalObj.closeAnnouncement = closeAnnouncement;
	globalObj.checkAnnouncementClosed = checkAnnouncementClosed;
</script>
